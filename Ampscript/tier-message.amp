%%[

/* Declare all variables */
var @firstName, @loyalty, @loyaltyMsg, @lastPurchase, @lapseMsg, @points 

/* Define First Name and fallback */
set @firstName = AttributeValue(FirstName)

if Empty(@firstName) then 
set @firstName = "Valued Member"
endif

/* Define tier-based messaging */
set @loyalty = AttributeValue("LoyaltyLevel")
if not Empty(@loyalty) then
    if @loyalty == "Platinum" then
    set @loyaltyMsg = "As one of our elite Platinum members, we’ve unlocked a VIP-only early access link for you."

    elseif @loyalty == "Bronze" then
    set @loyaltyMsg = "Welcome to the club! Check out our beginner rewards below."

    else
    set @loyaltyMsg = "You are doing great! You only need a few more points to reach the next level."

    endif
endif

/* Set lapse message if last purchase more than 60 days */
set @lastPurchase = DateParse(AttributeValue("LastPurchaseDate"))

if @lastPurchase < DateAdd(Now(),-60,"D") then
set @lapseMsg = "We miss you! Use code COMEBACK20 for 20% off your next order."
endif

/* Get points data and format to x,xxx */
set @points = FormatNumber(TreatAsNumber(AttributeValue("PointsBalance")), "N0")

]%%

<p>%%=v(@firstName)=%%,</p>
<p>%%=v(@loyaltyMsg)=%%</p>
<p>%%=v(@lapseMsg)=%%</p>
<p>You have %%=v(@points)=%% points in your rewards.</p>